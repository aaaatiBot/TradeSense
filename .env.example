# ==============================================================================
# TradeSense v3.1 Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials to version control.

# --- Application Core ---
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
HOST=127.0.0.1
PORT=5000
DEBUG=True

# --- Database ---
# SQLite for local development: sqlite:///tradesense.db
# PostgreSQL for production: postgresql+psycopg2://user:password@localhost:5432/tradesense
DATABASE_URL=sqlite:///tradesense.db

# --- Security & Hashing ---
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
SESSION_LIFETIME_HOURS=8
PASSWORD_RESET_TOKEN_LIFETIME_HOURS=1

# --- Budget & Trading Constraints ---
DEFAULT_BUDGET_MIN=100.00
DEFAULT_BUDGET_MAX=100000.00
DEFAULT_CASH_BUFFER_PCT=0.005
REFERENCE_TRADE_SIZE=500.00

# --- Rate Limiting ---
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_DEFAULT=100/minute

# --- Market Data Service ---
MARKET_DATA_PROVIDER=fyers
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.example.com/marketdata
MARKET_DATA_TIMEOUT_SECONDS=5.0
TICK_STALENESS_THRESHOLD_SECONDS=5.0

# --- Fyers Brokerage / Live WebSocket Streaming ---
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=

# --- Continuous News Ingestion ---
NEWS_RSS_FEEDS=https://feeds.feedburner.com/ndtvprofit-latest,https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.moneycontrol.com/rss/marketreports.xml,https://www.livemint.com/rss/markets
NEWS_POLL_INTERVAL_SECONDS=60

# --- Gemini API ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=10.0

# --- Blockchain Audit Service ---
BLOCKCHAIN_PROVIDER_URL=
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATION_BLOCKS=2

# --- Expected Return & ML Defaults ---
CONDITIONAL_RETURN_METHOD_VERSION=1.0
G_PLUS_PRIOR=0.0060
G_MINUS_PRIOR=-0.0060
SAMPLE_THRESHOLD_TICKER=30
SAMPLE_THRESHOLD_UNIVERSE=200

# --- Observability & Retention ---
LOG_LEVEL=INFO
RETENTION_SWEEP_SCHEDULE=0 2 * * *
